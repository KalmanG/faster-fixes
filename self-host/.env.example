# ---- Faster Fixes self-hosted: copy to self-host/.env and fill in ----

# Public hostname of this instance (DNS must point at the VPS; Traefik issues the cert)
DOMAIN_NAME=feedback.example.com
BASE_URL=https://feedback.example.com
BETTER_AUTH_URL=https://feedback.example.com
NEXT_PUBLIC_FF_API_ORIGIN=https://feedback.example.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres (the compose file creates the db with this password)
POSTGRES_PASSWORD=

# Inngest (self-hosted, in compose). openssl rand -hex 32 for each.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Screenshots: Cloudflare R2 bucket + token with Object Read & Write on it.
# STORAGE_BASE_URL is the bucket's public URL (r2.dev or a custom domain).
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=
STORAGE_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Transactional email (sign-up verification, password reset). Resend free tier.
# Without a verified sending domain Resend only delivers to the account owner's
# address and only from onboarding@resend.dev - fine for a single admin.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Optional: GitHub App for the GitHub Issues integration (free when self-hosted)
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# Image to run (built by .github/workflows/docker-image.yml)
FF_IMAGE=ghcr.io/kalmang/faster-fixes:latest

NEXT_PUBLIC_IS_CLOUD=false
